# ==============================================================================
# LUXIA AGRO ENTERPRISE - TEMPLATE DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env.local para configurar tus variables locales.
# NUNCA subas claves privadas o tokens reales al repositorio.
# ==============================================================================

NODE_ENV=development
PORT=4000

# Conexión Supabase PostgreSQL (Frontend)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Conexión Backend Worker
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
KONG_HTTP_PORT=8000
