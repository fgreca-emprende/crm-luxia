# ==============================================================================
# LUXIA AGRO ENTERPRISE - TEMPLATE DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env.local para configurar tus variables locales.
# NUNCA subas claves privadas o tokens reales al repositorio.
# ==============================================================================

NODE_ENV=development
PORT=4000

# Conexión Supabase PostgreSQL (Frontend)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Conexión Backend Worker
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
KONG_HTTP_PORT=8000

# [P1-1] Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# [P1-4 / P1-5] Configuración GoTrue Auth
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173,http://localhost:4173
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=5

# Claves de Servicios de IA e Integraciones Externas
GEMINI_API_KEY=your_gemini_api_key_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here
